# OpenAI / GPT-6 Sol for computer use (vision)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# For Sol: OPENAI_MODEL=gpt-6-sol, OPENAI_BASE_URL=...

# Browser settings
HEADLESS=true
SLOW_MO=100
MAX_STEPS=20
SCREENSHOT_DIR=demo/task-traces

# Cost tracking (approx)
COST_PER_1K_VISION_TOKENS=0.01
TOKENS_PER_SCREENSHOT=1000
